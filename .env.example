# ============================================================
# Cấu hình môi trường PinVuTru Cafe POS (.env.example)
# Copy file này thành ".env" ở thư mục gốc dự án rồi điền thông tin thật.
# File ".env" đã nằm trong .gitignore và KHÔNG BAO GIỜ bị đẩy lên GitHub.
# ============================================================

# 1. Thanh toán VietQR & SePay Webhook (để trống nếu dùng .NET User Secrets)
VietQr__BankId=MB
VietQr__AccountNo=SO_TAI_KHOAN_CUA_BAN
VietQr__AccountName=TEN_CHU_TK_IN_HOA_KHONG_DAU
VietQr__WebhookApiKey=CHUOI_API_KEY_TREN_SEPAY

# 2. Tên miền ngrok cố định (dùng cho Launcher\KhoiChay-CafePOS.bat)
NGROK_DOMAIN=https://ten-mien-ngrok-cua-ban.ngrok-free.dev

# 3. Trợ lý AI cục bộ (Ollama trên ổ D)
OLLAMA_MODELS=D:\AI_Models\ollama
Ollama__BaseUrl=http://127.0.0.1:11434
Ollama__Model=cafepos-qwen-lora

# 4. (Tùy chọn) Chuỗi kết nối PostgreSQL nếu không dùng .NET User Secrets
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=1024;Database=cafe_pos;Username=postgres;Password=YOUR_PASSWORD
